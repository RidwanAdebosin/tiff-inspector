# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Browser playground: the OCaml toplevel plus the TIFF inspector core, compiled to JavaScript"
maintainer: ["TIFF Inspector contributors"]
authors: ["TIFF Inspector contributors"]
license: "MIT"
homepage: "https://github.com/tiff-inspector/tiff-inspector"
bug-reports: "https://github.com/tiff-inspector/tiff-inspector/issues"
depends: [
  "dune" {>= "3.9"}
  "tiff-inspector" {= version}
  "js_of_ocaml" {>= "6.0"}
  "js_of_ocaml-compiler" {>= "6.0"}
  "js_of_ocaml-toplevel" {>= "6.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/tiff-inspector/tiff-inspector.git"
